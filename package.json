{
  "name": "bizbot-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prisma.mjs generate && next dev",
    "build": "node scripts/prisma.mjs setup && next build",
    "vercel-build": "node scripts/prisma.mjs setup && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/prisma.mjs generate",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs dev-migrate",
    "db:deploy": "node scripts/prisma.mjs migrate",
    "db:seed": "node prisma/seed.mjs",
    "test": "node --experimental-strip-types --test src/lib/paddle.test.ts src/lib/website-lead.test.ts src/lib/website-packages.test.ts src/lib/search-console.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "next": "16.4.6",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-pdf/types": "^2.14.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  },
  "engines": {
    "node": "22.x"
  }
}
