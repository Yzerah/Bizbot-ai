# Database. scripts/prisma.mjs picks the schema from this URL:
#   file:...        -> local SQLite (path is relative to prisma/sqlite/, so ../dev.db = prisma/dev.db)
#   postgresql://   -> PostgreSQL (production on Vercel / Neon, or a local Postgres)
DATABASE_URL="file:../dev.db"
# Production (Vercel env vars), e.g. Neon:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"   # pooled, runtime
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"            # unpooled, migrations
# (DIRECT_URL is optional: it defaults to DATABASE_URL_UNPOOLED, then POSTGRES_URL_NON_POOLING, then DATABASE_URL.)

# Secret used to sign session tokens. Generate: openssl rand -base64 32
AUTH_SECRET="change-me"

# Public site URL. Production: https://bizbot-ai.co.il
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Paddle Billing (optional). Without these, upgrade buttons stay "בקרוב" and nothing is charged. ---
# Create monthly prices in ILS: PRO = 119, BUSINESS = 249.
# NEXT_PUBLIC_PADDLE_ENV="sandbox"                 # sandbox | production
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""               # client-side token (test_... or live_...). Public by design.
# NEXT_PUBLIC_PADDLE_PRICE_PRO=""                  # pri_... monthly PRO, 119 ILS
# NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=""             # pri_... monthly BUSINESS, 249 ILS
# PADDLE_API_KEY=""                                # server API key. Never expose to the browser.
# PADDLE_WEBHOOK_SECRET=""                         # notification destination secret key
# Webhook URL: https://bizbot-ai.co.il/api/paddle/webhook
# Events: subscription.created, subscription.updated, subscription.activated,
#         subscription.canceled, subscription.past_due, subscription.paused,
#         subscription.resumed, subscription.trialing
