# Database. scripts/prisma.mjs picks the schema from this URL:
#   file:...        -> local SQLite (path is relative to prisma/sqlite/, so ../dev.db = prisma/dev.db)
#   postgresql://   -> PostgreSQL (production on Vercel / Neon, or a local Postgres)
DATABASE_URL="file:../dev.db"
# Production (Vercel env vars), e.g. Neon:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"   # pooled, runtime
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"            # unpooled, migrations
# (DIRECT_URL is optional: it defaults to DATABASE_URL_UNPOOLED, then POSTGRES_URL_NON_POOLING, then DATABASE_URL.)

# Secret used to sign session tokens. Generate: openssl rand -base64 32
AUTH_SECRET="change-me"

# Public site URL. Production: https://bizbot-ai.co.il
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Payments (not connected in v1; reserved for the next step) ---
# Stripe
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_PRO=""        # monthly price id, 119 ILS
# STRIPE_PRICE_BUSINESS=""   # monthly price id, 249 ILS
# Grow (Meshulam)
# GROW_PAGE_CODE=""
# GROW_USER_ID=""
# GROW_API_KEY=""
